{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "arise:shadow_archer",
      "materials": { "default": "zombie" },
      "textures": { "default": "textures/entity/arise/shadow_archer" },
      "geometry": { "default": "geometry.zombie.v1.8" },
      "scripts": {
        "pre_animation": [
          "variable.gliding_speed_value = 1.0;",
          "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
        ],
        "animate": ["move", "look_at_target"]
      },
      "animations": {
        "move": "animation.humanoid.move",
        "look_at_target": "animation.humanoid.look_at_target.default"
      },
      "render_controllers": ["controller.render.zombie"]
    }
  }
}
